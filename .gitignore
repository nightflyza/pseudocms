# PseudoCMS overlay package: track only PseudoCMS artifacts.
# Everything else belongs to the host YALF installation.

*

!.gitignore
!README.md

!api/
api/*
!api/libs/
api/libs/*
!api/libs/api.pseudocms.php

!modules/
modules/*
!modules/general/
modules/general/*
!modules/general/pages/
!modules/general/pages/**
!modules/general/articles/
!modules/general/articles/**
!modules/general/pcmsmgr/
!modules/general/pcmsmgr/**
!modules/general/rss/
!modules/general/rss/**
!modules/general/recent/
!modules/general/recent/**
!modules/general/pcmsmonitor/
!modules/general/pcmsmonitor/**

!languages/
languages/*
!languages/ukrainian/
languages/ukrainian/*
!languages/ukrainian/pseudocms.php

!content/
content/*
!content/documents/
content/documents/*
!content/documents/pseudocms/
content/documents/pseudocms/*
!content/documents/pseudocms/.gitkeep
!content/documents/pseudocms/.htaccess

!skins/
skins/*
!skins/pseudocms.css
